            "url": "https://iarpp.net/who-we-are/",
            "title": "IARPP: Who We Are",
            "locator": "Opening two paragraphs",
            "finding": "Relational accounts locate modifiable psychic structure in relations rather than innate drives alone."
          },
          {
            "url": "https://iarpp.net/who-we-are/what-we-do/",
            "title": "IARPP: What We Do",
            "locator": "Three levels of relational thinking",
            "finding": "Relational perspectives address internalized relations, context and therapeutic change within an evolving relationship."
          },
          {
            "url": "https://www.iarpp.net/membership/rpbs_titles.html",
            "title": "IARPP: Relational Perspectives Book Series",
            "locator": "Opening description of the series",
            "finding": "The editors describe a plural tradition rather than a unified school or fixed system."
          }
